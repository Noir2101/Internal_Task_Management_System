# ITMS backend — mẫu biến môi trường. Copy sang `.env` rồi điền giá trị thật.
# `.env` đã gitignore — KHÔNG commit secret.

# Postgres (Prisma đọc). Prisma pin v6.19 — url=env() còn dùng được.
DATABASE_URL="postgresql://itms:itms@localhost:5433/itms?schema=public"

# Auth (docs/06 §6.4). JWT_ACCESS_SECRET đủ dài + ngẫu nhiên; access TTL ngắn.
JWT_ACCESS_SECRET="thay-bang-chuoi-ngau-nhien-du-dai"
JWT_ACCESS_TTL="15m"
REFRESH_TTL_DAYS="7"
# Chỉ dùng cho e2e của FE. KHÔNG bật ở prod.
# THROTTLE_DISABLED="false"

# --- Notifications (bonus feature, docs/07.A) ---
# MAIL_ENABLED=false → NoopNotifier (không chạm mạng, mặc-định cho dev/CI/unit).
# MAIL_ENABLED=true  → EmailNotifier (nodemailer SMTP). Thiếu SMTP_*/MAIL_FROM khi true → fail-fast.
MAIL_ENABLED="false"
# Địa chỉ gửi. Demo Resend chưa verify domain: dùng "onboarding@resend.dev".
MAIL_FROM="ITMS <onboarding@resend.dev>"
# Provider prod = Resend (đổi provider = đổi các dòng SMTP_*, code không đổi).
SMTP_HOST="smtp.resend.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="resend"
# Resend API key (bắt đầu bằng "re_"). KHÔNG commit giá trị thật.
SMTP_PASS=""
